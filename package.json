{
  "name": "opd-register",
  "version": "2.1.0",
  "description": "OPD Register - clinic patient, treatment and payment register",
  "author": "Clinic",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.clinic.opdregister",
    "productName": "OPD Register",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "OPD-Register-Portable.exe"
    },
    "artifactName": "OPD-Register-Setup.${ext}"
  }
}